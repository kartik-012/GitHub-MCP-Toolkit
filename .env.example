# ==============================================================================
# GitHub MCP Toolkit - Environment Configuration Template
# ==============================================================================

# GitHub Authentication
# Fine-grained Personal Access Token scoped to target repositories
# Required permissions: Issues (Read & Write), Pull Requests (Read & Write)
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
GITHUB_USERNAME=your-github-username

# Webhook Security (Optional - for GitHub Webhook Event Verification)
# Secret configured in repository Webhook settings for HMAC SHA-256 verification
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Governance & RBAC (Optional)
# Supported roles: read_only, triage_operator, maintainer, admin
MCP_AGENT_ROLE=maintainer
MCP_SESSION_ID=default_session

# Transport Configuration (Optional: stdio or sse)
MCP_TRANSPORT=stdio

# Local Ollama Host Configuration (Optional - for local neural triage evaluation)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
