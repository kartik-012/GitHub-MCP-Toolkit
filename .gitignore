tool_calls.log
traces.jsonl
transactions.json

# Test / coverage artefacts
.pytest_cache/
.coverage
htmlcov/

# Eval logs — results are reproducible, not source
eval/last_run_log.json
eval/*_log.json
eval/*_results.json
